# Copy to .env and fill in. Never commit .env.

# The only number Jarvis answers and the one it calls (international format)
JARVIS_OWNER_NUMBER=+595XXXXXXXXX
# How Jarvis calls you
JARVIS_OWNER_NAME=Marcos
# Bluetooth address of the Android phone (bluetoothctl devices)
JARVIS_PHONE_BT_ADDR=AA:BB:CC:DD:EE:FF
# Optional: adb serial (or part of it) if more than one device is connected
JARVIS_PHONE_SERIAL=

# AWS credentials profile with Bedrock access to Nova 2.5 Sonic (leave empty for the default chain)
AWS_PROFILE=
AWS_REGION=us-east-1
JARVIS_MODEL_ID=amazon.nova-2-5-sonic
# Spanish voices: carlos (masculine) / lupe (feminine)
JARVIS_VOICE=carlos

# Answer calls whose number adb can't see (anyone could be calling). Off by default.
JARVIS_ANSWER_HIDDEN=0
# Log what is said on each call to the journal. Off by default (only role and length are logged).
JARVIS_DEBUG_TRANSCRIPTS=0
